# ─── Flask ─────────────────────────────────────────────────────
# Session secret — generate with: openssl rand -hex 32
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# ─── OpenD ─────────────────────────────────────────────────────
# Your Futu / moomoo user ID (numeric), phone (+86 138...), or email.
FUTU_LOGIN_ACCOUNT=

# Password MD5 (32-char lowercase hex) for headless CLI restarts after the
# VNC bootstrap. Generate:  echo -n 'yourpassword' | md5sum
# The VNC bootstrap is still needed ONCE for the device fingerprint.
FUTU_LOGIN_PWD_MD5=

# OpenD version to install. See https://openapi.futunn.com for latest.
# If you bump this, the container will download the new version and
# force a fresh VNC bootstrap on next `docker compose up`.
OPEND_VERSION=10.8.6808

# UI language for OpenD ("chs" | "en")
FUTU_LANG=chs

# OpenD log verbosity ("no" | "debug" | "info" | "warning" | "error" | "fatal")
FUTU_LOG_LEVEL=info

# ─── VNC bootstrap ─────────────────────────────────────────────
# Optional — pin a VNC password. If unset, a random 20-char password is
# generated once and stored in the opend-data volume. Retrieve with:
#   docker compose logs opend | grep 'VNC password'
VNC_PASSWORD=

# Where to expose the noVNC port. Change to 127.0.0.1 to only allow local
# access (recommended if server is public — use `ssh -L 6080:localhost:6080`
# to reach the browser UI from your laptop).
VNC_BIND=0.0.0.0
